# Copy to .env. Everything is optional: with nothing set, the API runs on
# SQLite + sample mails + the rule-based extractor + dev sign-in.

# Supabase Postgres connection string (Project settings → Database)
DATABASE_URL=sqlite:///./dev.db
CORS_ORIGINS=http://localhost:3000
# Leave empty in production; the default allows any localhost port
CORS_ORIGIN_REGEX=
ALLOWED_EMAIL_DOMAIN=vitstudent.ac.in

# Supabase auth: set SUPABASE_URL (JWKS, newer projects) or the legacy JWT secret
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Central inbox — run scripts/gmail_auth.py to get the refresh token
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
TRUSTED_SENDERS=helpdesk.cdc@vit.ac.in,cdc@vit.ac.in

# AI extraction (Gemini first, Groq backup, rules last)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Required in production for POST /cron/fetch
CRON_SECRET=

# ── Phase 2: notifications (the in-app bell works without any of these) ──
# Links inside messages
PUBLIC_SITE_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000

# Telegram: create a bot with @BotFather, paste its token and username (no @).
# Local: run `python -m app.notify.poll`. Production: set a webhook to
# <PUBLIC_API_URL>/telegram/webhook with secret_token=TELEGRAM_WEBHOOK_SECRET.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Email backup over SMTP (e.g. Gmail with an app password: smtp.gmail.com, port 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
