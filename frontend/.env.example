# Copy to .env.local. With nothing set, the site runs in demo mode on sample data.

# FastAPI backend (e.g. http://localhost:8000)
NEXT_PUBLIC_API_URL=

# Supabase project (Project settings → API) for VIT Google sign-in
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_ALLOWED_DOMAIN=vitstudent.ac.in
